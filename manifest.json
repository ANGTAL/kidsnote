{
  "manifest_version": 3,
  "name": "키즈노트 사진 다운로더",
  "version": "2.0",
  "description": "키즈노트 알림장/앨범 사진 및 영상을 다운로드합니다.",
  "permissions": [
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.kidsnote.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bohoon1229@gmail.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "키즈노트 사진 다운로드"
  },
  "content_scripts": [
    {
      "matches": ["https://www.kidsnote.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}